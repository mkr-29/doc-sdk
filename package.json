{
  "name": "@mkr-29/doc-sdk",
  "version": "0.1.0",
  "description": "Decoupled TypeScript documentation SDK with dynamic layouts, forms, and renderers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "author": "Mayank Kumar <mkr-29>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkr-29/doc-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/mkr-29/doc-sdk/issues"
  },
  "homepage": "https://github.com/mkr-29/doc-sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "documentation",
    "react",
    "sdk",
    "docs",
    "markdown",
    "schema",
    "api-reference",
    "dark-mode",
    "headless-cms"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.cjs"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite playground",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:harness": "vitest run tests/harness",
    "test:core": "vitest run tests/core",
    "test:blocks": "vitest run tests/blocks",
    "test:builder": "vitest run tests/admin/builder",
    "test:editor": "vitest run tests/admin/editor",
    "test:client": "vitest run tests/client",
    "test:hooks": "vitest run tests/hooks",
    "test:integration": "vitest run tests/integration",
    "build": "tsup",
    "prepublishOnly": "npm run test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.447.0",
    "markdown-to-jsx": "^7.4.7",
    "prismjs": "^1.29.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.7.4",
    "@types/prismjs": "^1.26.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.2"
  }
}
